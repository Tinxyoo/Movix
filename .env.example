# =============================================================================
# Movix 环境变量示例。复制为 .env 后按需修改。
# 加载顺序:shell 环境变量 > ~/.movix/.env > 工作区 .env(需 MOVIX_TRUST_REPO_ENV=1)
# =============================================================================

# ---- DeepSeek API ----
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- 基本运行参数 ----
# 最大迭代轮数(Agent 循环上限)。
MOVIX_MAX_ITERATIONS=30
# 单次响应最大输出 token 数,DeepSeek V4 官方上限 384K (393216),超过会被 API 截断或报错。
MOVIX_MAX_TOKENS=393216
# 工作区目录。
MOVIX_WORKSPACE=.
# 日志级别:trace/debug/info/warn/error。
MOVIX_LOG_LEVEL=info
# 日志文件路径(TUI 模式下日志写文件,不污染终端);不设置则不写日志文件。
# MOVIX_LOG_FILE=/tmp/movix.log
# 推理模式开关:enabled / disabled。
MOVIX_THINKING=enabled
# 推理强度:off / auto / high / max。
MOVIX_REASONING_EFFORT=auto
# UI 语言:zh / en。
MOVIX_LANGUAGE=zh

# ---- 会话 ----
# 启动时自动恢复上次会话;设 0 关闭。
MOVIX_AUTO_RESTORE=1
# 历史会话保留条数(超出按时间裁剪)。
# MOVIX_MAX_SESSION_HISTORY=200

# ---- 网络 / 端点安全 ----
# HTTP 读空闲超时(秒),默认 300。流式响应在该时间内无数据则超时。
# MOVIX_HTTP_TIMEOUT_SECS=300
# 允许 DEEPSEEK_BASE_URL 使用非 https 端点(明文传输 API key,仅在本地调试时启用)。
# MOVIX_ALLOW_INSECURE_ENDPOINT=0

# ---- 工作区 .env 信任 ----
# 工作区 .env 来源不可信(可被恶意仓库篡改)。设 1 才会加载工作区 .env。
# MOVIX_TRUST_REPO_ENV=0

# ---- Shell 出网控制 ----
# shell 默认禁止出网(curl/git push/wget 等数据外发);确认需要时再设 1。
# MOVIX_ALLOW_SHELL_EGRESS=0

# ---- 快照 ----
# 回滚时是否允许 `git clean -fd` 删除未跟踪文件。默认拒绝(只回滚已跟踪文件),
# 防止误删用户并发改动;确认要随回滚删除未跟踪文件时设 1。
# MOVIX_SNAPSHOT_CLEAN_UNTRACKED=0

# ---- Reviewer ----
# `/review` 评审允许的额外可信 host(逗号分隔,支持自部署/兼容代理)。
# MOVIX_REVIEWER_TRUST_HOSTS=api.my-proxy.com,api.another.com

# ---- MCP Server Configuration ----
# Simple format: name:command:arg1,arg2;name2:command2
# MOVIX_MCP_SERVERS=filesystem:npx:-y,@modelcontextprotocol/server-filesystem,/tmp
# JSON format (more flexible):
# MOVIX_MCP_CONFIG=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"enabled":true}]
# Or use .movix/mcp.json in workspace directory
# MCP 单次启动/握手超时(秒),默认 10。
# MOVIX_MCP_TIMEOUT_SECS=10
# 安全:工作区 .movix/mcp.json 来源不可信(可被恶意仓库篡改以自证 trusted:true)。
# 默认跳过文件来源的 MCP 服务器;确认信任时才设:
# MOVIX_TRUST_MCP_FILE=0
