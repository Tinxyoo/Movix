DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MOVIX_MAX_ITERATIONS=30
# 单次响应最大输出 token 数,DeepSeek V4 官方上限 384K (393216),超过会被 API 截断或报错。
MOVIX_MAX_TOKENS=393216
MOVIX_WORKSPACE=.
MOVIX_LOG_LEVEL=info
MOVIX_THINKING=enabled
MOVIX_REASONING_EFFORT=auto

# MCP Server Configuration
# Simple format: name:command:arg1,arg2;name2:command2
# MOVIX_MCP_SERVERS=filesystem:npx:-y,@modelcontextprotocol/server-filesystem,/tmp
# JSON format (more flexible):
# MOVIX_MCP_CONFIG=[{"name":"filesystem","command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"],"enabled":true}]
# Or use .movix/mcp.json in workspace directory
# 安全(审查):工作区 .movix/mcp.json 来源不可信(可被恶意仓库篡改以自证 trusted:true)。
# 默认跳过文件来源的 MCP 服务器;确认信任时才设:
# MOVIX_TRUST_MCP_FILE=1
# shell 默认禁止出网(curl/git push 等数据外发);确认需要时再设:
# MOVIX_ALLOW_SHELL_EGRESS=1
